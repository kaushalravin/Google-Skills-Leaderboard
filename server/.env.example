# Copy to server/.env and fill in the two required values. Never commit .env.
# Every variable is validated at boot; an invalid value stops the server (exit 1).

# --- Required ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/leaderboard
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# --- Server -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Comma-separated allowed browser origins (e.g. https://leaderboard.example.org). Empty = allow all.
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the app (for correct client IPs in rate limiting).
TRUST_PROXY=1
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_ADMIN_PER_MIN=30

# --- Competition ------------------------------------------------------------
# Badges earned on or after this date (UTC, inclusive) count.
COMPETITION_START_DATE=2026-10-26
# Optional inclusive end date (YYYY-MM-DD). Leave empty for none.
COMPETITION_END_DATE=

# --- Scheduled crawl --------------------------------------------------------
# Set to true once the go-live checklist in the README is done.
CRON_ENABLED=false
CRON_SCHEDULE=0 */6 * * *
CRON_TIMEZONE=Asia/Kolkata
# /api/health reports "degraded" when the last successful crawl is older than this.
STALE_AFTER_HOURS=13

# --- Crawler politeness and retries ------------------------------------------
CRAWL_CONCURRENCY=3
CRAWL_MIN_GAP_MS=500
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE_MS=1000
CRAWL_BACKOFF_MAX_MS=30000
CRAWL_RETRY_AFTER_MAX_MS=120000
LOCK_TTL_MS=120000

# --- Mass-empty run detection -------------------------------------------------
# A run of at least this many users where every scrape came back empty, or where
# empty results hit this share of users who had valid badges, is marked failed.
SUSPICIOUS_EMPTY_MIN_USERS=5
SUSPICIOUS_EMPTY_RATIO=0.3
