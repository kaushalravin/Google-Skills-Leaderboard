# Public base URL for the API.
# In development the Vite proxy forwards /api/* to localhost:4000,
# so you can leave this empty.
# In production set this to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.example.com
VITE_API_BASE_URL=

# Never put the ADMIN_API_KEY or any secret here.
# Admin credentials must remain server-side only.

