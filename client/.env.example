# Development: `npm run dev` serves on http://localhost:5173 and proxies /api/*
# to the backend at http://localhost:3000 (the server's default PORT).
# Set VITE_PROXY_TARGET only if your backend runs elsewhere.
VITE_PROXY_TARGET=

# Production builds only: the deployed backend's base URL, read by src/api.js
# at build time, e.g. https://your-backend.example.com
# The dev proxy does not use it; leave it empty for `npm run dev` so requests
# go through the proxy, and also when the built site and the API share an origin.
VITE_API_BASE_URL=

# Required for production builds: the public origin of this frontend, with no
# trailing slash, e.g. https://leaderboard.example.com. index.html uses it for the
# absolute Open Graph and Twitter image URLs (%VITE_SITE_URL%/og-image.png).
# If it is unset, the build prints a warning and the image URLs become relative
# (/og-image.png), so link previews show no image.
VITE_SITE_URL=

# Optional: a build identifier (e.g. a commit SHA) that names the service worker's
# cache. When empty, the hashed bundle URL is used, which changes whenever the code does.
VITE_BUILD_ID=

# Never put the ADMIN_API_KEY or any other secret here: VITE_ variables can be
# exposed to the browser bundle.
